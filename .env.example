# AI Provider Configuration (pollinations, mock, openai, stability)
AI_PROVIDER=pollinations

# Optional Upstream Paid AI Keys
OPENAI_API_KEY=
STABILITY_API_KEY=

# Supabase Cloud Storage & Database Configuration (Optional / Recommended for Vercel)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=artwork-images
SUPABASE_TABLE=artworks

# Server & Pipeline Settings
HOST=127.0.0.1
PORT=8000
MAX_RETRIES=3
OUTPUT_DIR=outputs
SIMULATE_CORRUPTION_TEST=false
